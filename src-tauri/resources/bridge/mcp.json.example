{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/allowed/path"],
      "env": {}
    },
    "custom-tool": {
      "command": "python",
      "args": ["${SKILL_ROOT}/servers/my-server.py"],
      "env": {
        "API_KEY": "${MY_API_KEY}"
      }
    }
  }
}
