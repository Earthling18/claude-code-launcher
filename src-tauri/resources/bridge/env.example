# ============================================================
# Mobot-Bridge 环境变量配置
# 复制此文件为 .env 后修改：cp .env.example .env
# 标注【必改】的项目必须根据实际环境填写
# ============================================================

# ---- Claude API 配置 ----

# 认证模式: oauth（推荐，使用 Claude Code 登录凭证）| key（API Key + Base URL）
WECOM_CLAUDE_AUTH_MODE=oauth

# Claude API 地址（oauth 模式留空；key 模式必填）
WECOM_CLAUDE_API_BASE=

# Claude API 密钥（oauth 模式留空；key 模式必填）
WECOM_CLAUDE_API_KEY=

# 模型名称（推荐 glm-5，可改为 minimax-m2.5 等）
# WECOM_CLAUDE_MODEL=glm-5

# Claude CLI 路径（留空=自动检测：oauth 模式优先用 npm 版本，key 模式用 SDK 内置）
WECOM_CLAUDE_CLI_PATH=

# ---- 网络代理配置（可选，留空=继承系统环境变量） ----
# WECOM_CLAUDE_HTTP_PROXY=http://proxy.example.com:8080
# WECOM_CLAUDE_HTTPS_PROXY=http://proxy.example.com:8080
# WECOM_CLAUDE_NO_PROXY=localhost,127.0.0.1

# ---- 会话配置 ----

# 会话超时时间（秒），超时后自动销毁会话
WECOM_SESSION_TTL=3600

# ---- 消息处理配置 ----

# 消息处理模式: queue（零延迟分发）| aggregate（聚合窗口）
# 注意：immediate_return_mode=true 时此项被忽略
WECOM_MESSAGE_PROCESSING_MODE=queue

# 聚合窗口时长（秒），仅 aggregate 模式生效
WECOM_AGGREGATION_WINDOW_SECONDS=6.0

# 队列等待超时（秒）
WECOM_QUEUE_TIMEOUT_SECONDS=1800.0

# ---- 文件输出配置 ----

# 文件输出模式: prompt（文本标记）| mcp（MCP工具）| all（全部返回）
WECOM_FILE_OUTPUT_MODE=prompt

# 文件缓存超时（秒）
WECOM_FILE_CACHE_TIMEOUT_SECONDS=300.0

# ---- 全异步推送配置（生产环境推荐） ----

# 是否启用全异步推送模式（true=HTTP 立即返回空响应，结果通过 sendMsg 推送）
WECOM_IMMEDIATE_RETURN_MODE=true

# 进度推送冷却间隔（秒）
WECOM_PROGRESS_PUSH_INTERVALS=15

# 异步超时（秒）：0=禁用，>0=超时后切异步推送
WECOM_ASYNC_TIMEOUT_SECONDS=0

# ---- sendMsg 主动推送配置（全异步模式必需） ----

# sendMsg 推送接口地址（所有部署者共用，无需修改）
WECOM_SENDMSG_API_URL=http://172.21.193.224:31003/plugin-b2aa-sendmsg/mcp

# sendMsg 认证密钥（默认为"艾灵"，可从"数字员工管理员后台"获取其他数字员工的 AuthKey 替换）
WECOM_SENDMSG_AUTH_KEY=13f64987826f0779ae3568a8d1c3f377

# sendMsg 部门用户 ID（默认为"艾灵"，可从"数字员工管理员后台"获取其他数字员工的 DepUserId 替换）
WECOM_SENDMSG_DEP_USER_ID=alin

# ---- COS 文件服务配置 ----

# COS API 地址（所有部署者共用，无需修改）
WECOM_COS_API_BASE=http://172.21.193.224:31003/plugin-b2dj-digit-cosfile-mcp

# ---- 访问控制 ----

# 用户白名单（逗号分隔的用户 ID，空=不限制）
# WECOM_USER_WHITELIST=user1,user2

# ---- 更新后端配置（可选） ----

# 更新后端: auto（默认，PyPI 优先 GitHub 回退）| pypi | github
# MOBOT_UPDATE_BACKEND=auto

# ---- 飞书渠道配置（可选，配置 APP_ID + APP_SECRET 后自动启用） ----
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=

# 飞书用户白名单（逗号分隔的 open_id，空=不限制）
# FEISHU_USER_WHITELIST=
