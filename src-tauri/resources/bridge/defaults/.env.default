# ============================================================
# Claude Launcher Agent 环境变量配置
# 此文件由 Launcher 首次运行时自动创建
# 修改后重启桥接生效
# ============================================================

# ---- Claude API 配置（由 Launcher UI 管理，启动时自动覆盖） ----
# 以下字段无需手动修改，Launcher 启动桥接时会通过环境变量注入 UI 上的配置

# 认证模式: oauth | proxy（由 UI 的 Agent 模式决定）
# WECOM_CLAUDE_AUTH_MODE=oauth

# Claude API 地址 / 密钥 / 模型 / 代理（由 UI 注入，此处不设置）
# WECOM_CLAUDE_API_BASE=
# WECOM_CLAUDE_API_KEY=
# WECOM_CLAUDE_MODEL=
# WECOM_HTTP_PROXY=

# Claude CLI 路径（留空使用 SDK 内置）
WECOM_CLAUDE_CLI_PATH=

# 最大对话轮数（由 UI 的 Max Turns 注入）
# WECOM_AGENT_MAX_TURNS=3

# ---- 会话配置 ----

# 会话超时时间（秒），超时后自动销毁会话
WECOM_SESSION_TTL=3600

# ---- 消息处理配置 ----

WECOM_MESSAGE_PROCESSING_MODE=queue
WECOM_AGGREGATION_WINDOW_SECONDS=6.0
WECOM_QUEUE_TIMEOUT_SECONDS=1800.0

# ---- 文件输出配置 ----

WECOM_FILE_OUTPUT_MODE=prompt
WECOM_FILE_CACHE_TIMEOUT_SECONDS=300.0

# ---- 异步推送配置 ----

# 桥接场景开启全异步推送（HTTP 立即返回，结果通过 sendMsg 推送）
WECOM_IMMEDIATE_RETURN_MODE=true
WECOM_PROGRESS_PUSH_INTERVALS=15
WECOM_ASYNC_TIMEOUT_SECONDS=0

# ---- sendMsg 主动推送配置 ----

WECOM_SENDMSG_API_URL=http://172.21.193.224:31003/plugin-b2aa-sendmsg/mcp
WECOM_SENDMSG_AUTH_KEY=13f64987826f0779ae3568a8d1c3f377
WECOM_SENDMSG_DEP_USER_ID=alin

# ---- COS 文件服务配置 ----

WECOM_COS_API_BASE=http://172.21.193.224:31003/plugin-b2dj-digit-cosfile-mcp

# ---- 访问控制（留空=不限制） ----

WECOM_USER_WHITELIST=
