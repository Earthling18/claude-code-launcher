  "_说明": {
    "cron格式": "分 时 日 月 周（5段式）",
    "cron示例": {
      "每天早上7点": "0 7 * * *",
      "每天下午3点": "0 15 * * *",
      "每周一早上9点": "0 9 * * 1",
      "工作日早上8点": "0 8 * * 1-5",
      "每月1号早上9点": "0 9 1 * *"
