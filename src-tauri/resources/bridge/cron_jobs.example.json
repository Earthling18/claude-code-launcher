    "context_type": "private（私聊创建）或 group（群聊创建）",
    "target_type": "self（发给自己）或 group（发到群）",
    "发送规则": {
      "私聊创建": "只能发给自己",
      "群聊创建": "可以发到当前群，或私发给自己"
