{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "clipboard-manager:allow-write-text",
    "updater:default",
    "process:allow-restart",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize"
  ]
}
