{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CC 启动器",
  "version": "1.2.6",
  "identifier": "com.claudecode.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node scripts/patch-version-info.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CC 启动器",
        "width": 720,
        "height": 720,
        "minWidth": 640,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "publisher": "微众银行",
    "copyright": "版权所有 © 2026",
    "shortDescription": "Mobot Launcher",
    "longDescription": "Mobot Launcher，支持桌面、远程启动claudecode、codex等服务，并对接企微、飞书",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGMUMwMzI4RUFBNEM2QzMKUldURHhxVHFLQU1jTDdXZmd1eWd6R1JRZFNlU2pYWTY5T1BpbGY0cjBtek9lWHNaSXR0VDU2QzIK",
      "endpoints": [
        "https://cc-launcher-dist.oss-cn-shanghai.aliyuncs.com/releases/latest.json",
        "https://github.com/Earthling18/claude-code-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
